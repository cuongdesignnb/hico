index 0000000..76d024f
--- /dev/null
+++ b/src/components/Admin/Catalog/ProductStatsCards.tsx
@@ -0,0 +1,118 @@
+import { useMemo } from 'react';
+import { AlertTriangle, Boxes, CheckCircle2, Package, RefreshCw } from 'lucide-react';
+import type { CatalogProductRecord } from '../../../types/catalog';
+
+interface ProductStatsCardsProps {
+  products: CatalogProductRecord[];
+}
+
+const formatNumber = (value: number) => new Intl.NumberFormat('vi-VN').format(value);
+
+const ProductStatsCards = ({ products }: ProductStatsCardsProps) => {
+  const stats = useMemo(() => {
+    let activeCount = 0;
+    let reviewCount = 0;
+    let providerMapped = 0;
+    let totalMappableVariants = 0;
+    let qrPoolCount = 0;
+
+    products.forEach((product) => {
+      if (product.status === 'active') activeCount += 1;
+      product.variants.forEach((variant) => {
+        if (variant.needsReview) reviewCount += 1;
+        if (variant.fulfillmentMethod) {
+          totalMappableVariants += 1;
+          if (variant.providerOfferId || variant.wmproductId) providerMapped += 1;
+        }
+        if (variant.fulfillmentMethod === 'HICO_MANUAL_QR' && typeof variant.stock === 'number') {
+          qrPoolCount += variant.stock;
+        }
+      });
+    });
+
+    const syncRatio = totalMappableVariants > 0 ? Math.round((providerMapped / totalMappableVariants) * 1000) / 10 : 0;
+
+    return {
+      total: products.length,
+      active: activeCount,
+      review: reviewCount,
+      syncRatio,
+      syncMapped: providerMapped,
+      syncTotal: totalMappableVariants,
+      qrPool: qrPoolCount,
+    };
+  }, [products]);
+
+  return (
+    <div className="catalog-kpi-grid" aria-label="Tổng quan sản phẩm">
+      <div className="catalog-kpi-card catalog-kpi-card--primary">
+        <div className="catalog-kpi-card__icon">
+          <Package size={20} />
+        </div>
+        <div className="catalog-kpi-card__body">
+          <span className="catalog-kpi-card__label">Tổng sản phẩm</span>
+          <strong className="catalog-kpi-card__value">{formatNumber(stats.total)}</strong>
+          <span className="catalog-kpi-card__sub">Toàn bộ danh mục</span>
+        </div>
+      </div>
+
+      <div className="catalog-kpi-card catalog-kpi-card--success">
+        <div className="catalog-kpi-card__icon">
+          <CheckCircle2 size={20} />
+        </div>
+        <div className="catalog-kpi-card__body">
+          <span className="catalog-kpi-card__label">Đang bán</span>
+          <strong className="catalog-kpi-card__value">{formatNumber(stats.active)}</strong>
+          <span className="catalog-kpi-card__sub">
+            {stats.total > 0
+              ? `${Math.round((stats.active / stats.total) * 100)}% tổng sản phẩm`
+              : 'Chưa có dữ liệu'}
+          </span>
+        </div>
+      </div>
+
+      <div className="catalog-kpi-card catalog-kpi-card--warning">
+        <div className="catalog-kpi-card__icon">
+          <AlertTriangle size={20} />
+        </div>
+        <div className="catalog-kpi-card__body">
+          <span className="catalog-kpi-card__label">Cần review</span>
+          <strong className="catalog-kpi-card__value">{formatNumber(stats.review)}</strong>
+          <span className="catalog-kpi-card__sub">
+            {stats.review > 0 ? 'Cần xác nhận nguồn' : 'Không có cảnh báo'}
+          </span>
+        </div>
+      </div>
+
+      <div className="catalog-kpi-card catalog-kpi-card--info">
+        <div className="catalog-kpi-card__icon">
+          <RefreshCw size={20} />
+        </div>
+        <div className="catalog-kpi-card__body">
+          <span className="catalog-kpi-card__label">Đồng bộ provider</span>
+          <strong className="catalog-kpi-card__value">{stats.syncRatio}%</strong>
+          <span className="catalog-kpi-card__sub">
+            {stats.syncTotal > 0
+              ? `${formatNumber(stats.syncMapped)} / ${formatNumber(stats.syncTotal)} variant`
+              : 'Chưa có variant'}
+          </span>
+        </div>
+      </div>
+
+      <div className="catalog-kpi-card catalog-kpi-card--neutral">
+        <div className="catalog-kpi-card__icon">
+          <Boxes size={20} />
+        </div>
+        <div className="catalog-kpi-card__body">
+          <span className="catalog-kpi-card__label">Tồn kho / QR pool</span>
+          <strong className="catalog-kpi-card__value">{formatNumber(stats.qrPool)}</strong>
+          <span className="catalog-kpi-card__sub">
+            {stats.qrPool > 0 ? 'QR khả dụng' : 'Theo provider'}
+          </span>
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default ProductStatsCards;
