+  cursor: pointer;
+}
+
+.catalog-overview-panel__close:hover {
+  background: #f3f4f6;
+  color: var(--admin-text-dark);
+}
+
+.catalog-overview-panel__body {
+  padding: 12px 14px;
+}
+
+.catalog-overview-section {
+  margin-bottom: 12px;
+}
+
+.catalog-overview-section:last-child {
+  margin-bottom: 0;
+}
+
+.catalog-overview-section strong {
+  display: block;
+  color: var(--admin-text-light);
+  font-size: 10px;
+  text-transform: uppercase;
+  margin-bottom: 4px;
+}
+
+.catalog-overview-placeholder {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  padding: 24px 16px;
+  color: var(--admin-text-light);
+  text-align: center;
+}
+
+.catalog-overview-placeholder strong {
+  color: var(--admin-text-dark);
+  font-size: 13px;
+}
+
+.catalog-overview-placeholder span {
+  font-size: 11px;
+}
+
+/* Activity feed / Queue summary */
+.catalog-activity-feed {
+  flex: 1;
+  padding: 12px 14px;
+  border-top: 1px solid var(--admin-border);
+}
+
+.catalog-activity-feed__heading {
+  margin-bottom: 10px;
+}
+
+.catalog-activity-feed__heading h3 {
+  margin: 0 0 4px;
+  color: var(--admin-text-dark);
+  font-size: 12px;
+}
+
+.catalog-activity-feed__heading span {
+  color: var(--admin-text-light);
+  font-size: 10.5px;
+}
+
+.catalog-activity-feed__list {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.catalog-activity-feed__item {
+  display: flex;
+  align-items: flex-start;
+  gap: 8px;
+  width: 100%;
+  padding: 8px 10px;
+  border: 1px solid var(--admin-border);
+  border-radius: 6px;
+  background: #fff;
+  text-align: left;
+  cursor: pointer;
+  font-size: 11px;
+}
+
+.catalog-activity-feed__item:hover {
+  border-color: var(--admin-primary);
+}
+
+.catalog-activity-feed__item--warning { border-color: #fde68a; background: #fffbeb; }
+.catalog-activity-feed__item--info { border-color: #bfdbfe; background: #eff6ff; }
+.catalog-activity-feed__item--danger { border-color: #fecaca; background: #fef2f2; }
+.catalog-activity-feed__item--neutral { border-color: var(--admin-border); background: #f9fafb; }
+
+.catalog-activity-feed__icon {
+  flex-shrink: 0;
+  width: 20px;
+  height: 20px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 4px;
+}
+
+.catalog-activity-feed__item--warning .catalog-activity-feed__icon { background: #fef3c7; color: #b45309; }
+.catalog-activity-feed__item--info .catalog-activity-feed__icon { background: #dbeafe; color: #1d4ed8; }
+.catalog-activity-feed__item--danger .catalog-activity-feed__icon { background: #fef2f2; color: #b91c1c; }
+.catalog-activity-feed__item--neutral .catalog-activity-feed__icon { background: #f3f4f6; color: #6b7280; }
+
+.catalog-activity-feed__body {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+
+.catalog-activity-feed__body strong {
+  color: var(--admin-text-dark);
+  font-size: 11px;
+}
+
+.catalog-activity-feed__body span {
+  color: var(--admin-text-light);
+  font-size: 10px;
+}
+
+.catalog-activity-feed__tab.is-active {
+  background: var(--admin-primary);
+  border-color: var(--admin-primary);
+  color: #fff;
+}
+
+.catalog-activity-feed__list {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.catalog-activity-item {
+  display: flex;
+  align-items: flex-start;
+  gap: 8px;
+  padding: 8px 10px;
+  border: 1px solid var(--admin-border);
+  border-radius: 6px;
+  background: #fff;
+  font-size: 11px;
+}
+
+.catalog-activity-item__icon {
+  flex-shrink: 0;
+  width: 20px;
+  height: 20px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 4px;
+}
+
+.catalog-activity-item__icon--warning { background: #fef3c7; color: #b45309; }
+.catalog-activity-item__icon--error { background: #fef2f2; color: #b91c1c; }
+.catalog-activity-item__icon--info { background: #eff6ff; color: #1d4ed8; }
+
+.catalog-activity-item__content {
+  min-width: 0;
+}
+
+.catalog-activity-item__title {
+  color: var(--admin-text-dark);
+  font-weight: 600;
+}
+
+.catalog-activity-item__meta {
+  color: var(--admin-text-light);
+  font-size: 10px;
+  margin-top: 2px;
+}
+
+.catalog-activity-empty {
+  padding: 16px;
+  text-align: center;
+  color: var(--admin-text-light);
+  font-size: 11px;
+}
+
+/* Empty state */
+.catalog-tab__empty {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  padding: 40px 20px;
+  text-align: center;
+  color: var(--admin-text-light);
+}
+
+.catalog-tab__empty strong {
+  color: var(--admin-text-dark);
+  font-size: 14px;
+}
+
+/* Overview panel extra styles */
+.catalog-overview-panel__head-product {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-width: 0;
+}
+
+.catalog-overview-panel__title {
+  min-width: 0;
+  flex: 1;
+}
+
+.catalog-overview-panel__title strong {
+  display: block;
+  color: var(--admin-text-dark);
+  font-size: 12px;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.catalog-overview-panel__title span {
+  color: var(--admin-text-light);
+  font-size: 10px;
+}
+
+.catalog-overview-panel__actions {
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+  padding: 8px 0;
+}
+
+.catalog-overview-panel__tabs {
+  display: flex;
+  gap: 4px;
+  padding: 8px 0;
+  border-bottom: 1px solid var(--admin-border);
+  flex-wrap: wrap;
+}
+
+.catalog-overview-panel__tab {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 4px 8px;
+  border: 0;
+  border-radius: 4px;
+  background: transparent;
+  color: var(--admin-text-medium);
+  font-size: 10.5px;
+  cursor: pointer;
+}
+
+.catalog-overview-panel__tab:hover {
+  background: #f3f4f6;
+  color: var(--admin-text-dark);
+}
+
+.catalog-overview-panel__tab.is-active {
+  background: var(--admin-primary);
+  color: #fff;
+}
+
+.catalog-overview-panel__overview {
+  padding: 8px 0;
+}
+
+.catalog-overview-panel__list {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.catalog-overview-panel__list > div {
+  display: flex;
+  justify-content: space-between;
