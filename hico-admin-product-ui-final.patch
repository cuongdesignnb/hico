+@media (max-width: 1200px) {
+  .catalog-tab__side {
+    position: fixed;
+    right: 0;
+    top: 0;
+    bottom: 0;
+    z-index: 110;
+    width: min(420px, 100vw);
+    max-height: none;
+    background: #fff;
+    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.1);
+    transform: translateX(100%);
+    transition: transform 0.2s ease;
+  }
