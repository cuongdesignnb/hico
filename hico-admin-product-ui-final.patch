+/* === Product Admin Redesign CSS === */
+
+/* Tab Header */
+.catalog-tab__header {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 18px 20px;
+  border-bottom: 1px solid var(--admin-border);
+}
+
+.catalog-tab__header-info h2 {
+  margin: 0;
+  color: var(--admin-text-dark);
+  font-size: 16px;
+}
+
+.catalog-tab__header-info p {
+  margin: 4px 0 0;
+  color: var(--admin-text-light);
+  font-size: 12px;
+}
+
+.catalog-tab__breadcrumb {
+  display: block;
+  color: var(--admin-text-light);
+  font-size: 11px;
+  margin-bottom: 4px;
+}
+
+.catalog-tab__header-actions {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+
+.catalog-secondary-outline-button {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  min-height: 34px;
+  padding: 7px 11px;
+  border: 1px solid var(--admin-border);
+  border-radius: 6px;
+  background: #fff;
+  color: var(--admin-text-dark);
+  font-size: 12px;
+  cursor: pointer;
+}
+
+.catalog-secondary-outline-button:hover {
+  border-color: var(--admin-primary);
+  color: var(--admin-primary);
+}
+
+.catalog-secondary-outline-button:disabled {
+  cursor: not-allowed;
+  opacity: 0.5;
+}
+
+/* Summary row */
+.catalog-tab__summary {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  border-bottom: 1px solid var(--admin-border);
+  background: #f8fafc;
+}
+
+.catalog-tab__summary > div {
+  min-width: 0;
+  padding: 14px 20px;
+  border-right: 1px solid var(--admin-border);
+}
+
+.catalog-tab__summary > div:last-child {
+  border-right: 0;
+}
+
+.catalog-tab__summary span {
+  display: block;
+  color: var(--admin-text-light);
+  font-size: 11px;
+  margin-bottom: 4px;
+}
+
+.catalog-tab__summary strong {
+  display: block;
+  color: var(--admin-text-dark);
+  font-size: 15px;
+  overflow-wrap: anywhere;
+}
+
+/* KPI Cards */
+.catalog-kpi-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
+  gap: 12px;
+  padding: 16px 20px;
+  border-bottom: 1px solid var(--admin-border);
+}
+
+.catalog-kpi-card {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 12px 14px;
+  border-radius: 8px;
+  border: 1px solid transparent;
+}
+
+.catalog-kpi-card--primary { background: #eff6ff; border-color: #bfdbfe; }
+.catalog-kpi-card--success { background: #f0fdf4; border-color: #bbf7d0; }
+.catalog-kpi-card--warning { background: #fffbeb; border-color: #fde68a; }
+.catalog-kpi-card--neutral { background: #f9fafb; border-color: var(--admin-border); }
+.catalog-kpi-card--info { background: #f5f3ff; border-color: #ddd6fe; }
+
+.catalog-kpi-card__icon {
+  flex-shrink: 0;
+  width: 36px;
+  height: 36px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 8px;
+}
+
+.catalog-kpi-card--primary .catalog-kpi-card__icon { background: #dbeafe; color: #1d4ed8; }
+.catalog-kpi-card--success .catalog-kpi-card__icon { background: #dcfce7; color: #15803d; }
+.catalog-kpi-card--warning .catalog-kpi-card__icon { background: #fef3c7; color: #b45309; }
+.catalog-kpi-card--neutral .catalog-kpi-card__icon { background: #f3f4f6; color: #6b7280; }
+.catalog-kpi-card--info .catalog-kpi-card__icon { background: #ede9fe; color: #7c3aed; }
+
+.catalog-kpi-card__body {
+  min-width: 0;
+}
+
+.catalog-kpi-card__label {
+  color: var(--admin-text-light);
+  font-size: 11px;
+}
+
+.catalog-kpi-card__value {
+  color: var(--admin-text-dark);
+  font-size: 18px;
+  font-weight: 700;
+}
+
+.catalog-kpi-card__sub {
+  color: var(--admin-text-light);
+  font-size: 10px;
+}
+
+/* Filters section */
+.catalog-filters-section {
+  padding: 16px 20px;
+  border-bottom: 1px solid var(--admin-border);
+}
+
+.catalog-filters-row {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+
+.catalog-search-wrapper {
+  position: relative;
+  flex: 1;
+  min-width: 200px;
+  max-width: 320px;
+}
+
+.catalog-search-icon {
+  position: absolute;
+  left: 10px;
+  top: 50%;
+  transform: translateY(-50%);
+  color: var(--admin-text-light);
+  pointer-events: none;
+}
+
+.catalog-search-input {
+  width: 100%;
+  height: 36px;
+  padding: 0 10px 0 34px;
+  border: 1px solid var(--admin-border);
+  border-radius: 6px;
+  font-size: 12px;
+  color: var(--admin-text-dark);
+  background: #fff;
+}
+
+.catalog-search-input:focus {
+  border-color: var(--admin-primary);
+  outline: none;
+}
+
+.catalog-filters-grid {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+
+.catalog-filter-label {
+  color: var(--admin-text-light);
+  font-size: 11px;
+  font-weight: 600;
+}
+
+.catalog-chips {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  flex-wrap: wrap;
+}
+
+.catalog-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 5px 10px;
+  border: 1px solid var(--admin-border);
+  border-radius: 16px;
+  background: #fff;
+  color: var(--admin-text-dark);
+  font-size: 11px;
+  cursor: pointer;
+  white-space: nowrap;
+}
+
+.catalog-chip:hover {
+  border-color: var(--admin-primary);
+  color: var(--admin-primary);
+}
+
+.catalog-chip.is-active {
+  background: var(--admin-primary);
+  border-color: var(--admin-primary);
+  color: #fff;
+}
+
+/* Tab split layout */
+.catalog-tab__split {
+  display: flex;
+  min-height: 0;
+}
+
+.catalog-tab__list {
+  flex: 1;
+  min-width: 0;
+  overflow-x: auto;
+}
+
+.catalog-tab__side {
+  width: 340px;
+  flex-shrink: 0;
+  border-left: 1px solid var(--admin-border);
+  display: flex;
+  flex-direction: column;
+  overflow-y: auto;
+  max-height: 500px;
+}
+
+/* Overview panel */
+.catalog-overview-panel {
+  border-bottom: 1px solid var(--admin-border);
+  background: #fff;
+}
+
+.catalog-overview-panel__head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  padding: 12px 14px;
+  border-bottom: 1px solid var(--admin-border);
+}
+
+.catalog-overview-panel__head-info {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.catalog-overview-panel__head-product {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-width: 0;
+}
+
+.catalog-overview-panel__avatar {
+  width: 36px;
+  height: 36px;
+  border-radius: 6px;
+  object-fit: cover;
+  background: #eef2f7;
+  flex-shrink: 0;
+}
+
+.catalog-overview-panel__avatar--placeholder {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  background: #e0f2fe;
+  color: #0369a1;
+  font-size: 12px;
+  font-weight: 800;
+}
+
+.catalog-overview-panel__title {
+  min-width: 0;
+  overflow: hidden;
+}
+
+.catalog-overview-panel__title strong {
+  display: block;
+  color: var(--admin-text-dark);
+  font-size: 12.5px;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.catalog-overview-panel__title span {
+  display: block;
+  color: var(--admin-text-light);
+  font-size: 10.5px;
+}
+
+.catalog-overview-panel__close {
+  flex-shrink: 0;
+  width: 28px;
+  height: 28px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border: none;
+  border-radius: 4px;
+  background: transparent;
