{
  "name": "hc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run prerender",
    "lint": "eslint .",
    "preview": "vite preview",
    "prerender": "node scripts/prerender-public-routes.mjs",
    "security:audit": "npm audit --omit=dev && npm --prefix server audit --omit=dev",
    "security:gate": "node scripts/security-gate.mjs",
    "customer:inventory": "npm --prefix server run customer:inventory",
    "customer-assets:backfill": "npm --prefix server run customer-assets:backfill",
    "customer-assets:validate": "npm --prefix server run customer-assets:validate",
    "customer-auth:validate": "npm --prefix server run customer-auth:validate",
    "customer-orders:validate": "npm --prefix server run customer-orders:validate",
    "customer-dashboard:validate": "npm --prefix server run customer-dashboard:validate",
    "loyalty:backfill": "npm --prefix server run loyalty:backfill",
    "loyalty:validate": "npm --prefix server run loyalty:validate",
    "loyalty:reconcile": "npm --prefix server run loyalty:reconcile",
    "referrals:validate": "npm --prefix server run referrals:validate",
    "customer-notifications:validate": "npm --prefix server run customer-notifications:validate",
    "customer-profile:validate": "npm --prefix server run customer-profile:validate",
    "support:validate": "npm --prefix server run support:validate",
    "referrals:backfill": "npm --prefix server run referrals:backfill",
    "production:launch:validate": "npm --prefix server run production:launch:validate",
    "production:report": "npm --prefix server run production:report",
